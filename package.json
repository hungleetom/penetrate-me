{
  "name": "penetrate-me-local",
  "version": "1.0.0",
  "private": true,
  "description": "Disposable, loopback-only social network for authorized web security testing",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build --webpack",
    "start": "node scripts/dev.mjs --production",
    "typecheck": "next typegen && tsc --noEmit",
    "db:init": "node scripts/reset.mjs",
    "db:seed": "node scripts/seed-runner.mjs",
    "db:reset": "node scripts/reset.mjs",
    "test": "node scripts/test.mjs",
    "test:browser": "playwright test",
    "test:reset": "node tests/reset-check.mjs",
    "postinstall": "prisma generate"
  },
  "prisma": {"seed": "tsx scripts/seed.ts"},
  "engines": {"node": ">=24.0.0"},
  "dependencies": {
    "@prisma/client": "6.19.3",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "lucide-react": "1.70.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "tailwindcss": "4.3.5",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
